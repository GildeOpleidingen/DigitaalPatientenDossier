# Auto-detect all text files and normalize line endings to LF
* text=auto eol=lf

# Explicit text files
*.php text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.sql text eol=lf
*.json text eol=lf
*.md text eol=lf
*.env* text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf

# Binary files (do not touch line endings)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

